# =============================================================
# End-to-End Data Lakehouse Platform — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakehouse
POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=change_me_strong_password

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://lakehouse_user:change_me_strong_password@localhost:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=change_me_fernet_key_32_url_safe_base64_chars==
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_webserver_secret_key

# Spark / Delta Lake paths
SPARK_MASTER=local[*]
DELTA_LAKE_PATH=/opt/lakehouse/delta
DATA_PATH=/opt/lakehouse/data

# Pipeline
PIPELINE_BATCH_ID=auto
LOG_LEVEL=INFO
